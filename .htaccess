# ============================================================
#  Keep AI — .htaccess Security & Configuration
# ============================================================

# --- Block direct access to sensitive files (Allowing manifest.json) ---
<FilesMatch "\.(db|sqlite|env|log|sh|bak|sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Specifically protect sensitive JSON while allowing manifest
<FilesMatch "^(?!(manifest)).*\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# --- Block access to api/config.php directly ---
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# --- Block access to /database/ directory ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^database/ - [F,L]
</IfModule>

# --- Security Headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://www.gstatic.com https://apis.google.com https://accounts.google.com https://*.paypal.com https://*.paypalobjects.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com https://*.paypal.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: https://*.paypal.com https://*.paypalobjects.com; frame-src 'self' https://accounts.google.com https://*.paypal.com https://*.paypalobjects.com; connect-src 'self' https: https://accounts.google.com https://*.paypal.com https://*.paypalobjects.com;"
    Header always set Permissions-Policy "microphone=(self)"

    # --- CORS for API ---
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# --- Handle preflight OPTIONS requests ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# --- PHP Settings ---
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddType application/manifest+json .json
    AddCharset UTF-8 .js
    AddCharset UTF-8 .css
    AddCharset UTF-8 .html
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json
</IfModule>

# --- Cache static assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    # NEVER cache the Service Worker or the main entry point
    <FilesMatch "(keepai-sw\.js|sw\.js|index\.html)$">
        ExpiresActive Off
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
